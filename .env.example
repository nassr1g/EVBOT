# انسخ هذا الملف إلى .env محلياً فقط للتجربة على جهازك (لا يُرفع لـ GitHub أبداً)
# على Hostless (أو أي استضافة سحابية): لا تستخدم ملف .env إطلاقاً —
# أضف هذي القيم يدوياً من لوحة التحكم > Advanced Settings > Set Environment Variables

# مفتاح Gemini (إلزامي) — أنشئه من: https://aistudio.google.com/apikey
GEMINI_API_KEY=ضع_مفتاحك_هنا

# مفتاح Tavily (اختياري، للبحث) — من: https://app.tavily.com
TAVILY_API_KEY=ضع_مفتاحك_هنا

# مفتاح Serper (اختياري، لحزم الملصقات/الصور) — من: https://serper.dev
SERPER_API_KEY=ضع_مفتاحك_هنا

# رقمك مع كود الدولة بدون + (لربط الجهاز عبر كود اقتران بدل QR)
PHONE_NUMBER=967xxxxxxxxx
